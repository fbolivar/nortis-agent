<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente de paquetes para las extensiones de WiX que arman el instalador.

  Va en el repositorio y no en la configuracion global de la maquina por dos
  razones: no toca la maquina de nadie —la global puede estar vaciada a
  proposito por politica de la empresa— y CI construye contra exactamente la
  misma fuente que el desarrollador.

  clear vacia lo que venga heredado de configuraciones de nivel superior, para
  que la construccion no dependa de que haya o no un feed corporativo definido
  en el equipo.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
