# Binarios compilados
*.exe
*.exe~
*.dll
*.so
*.dylib
/dist/

# Datos locales del agente (nunca deben versionarse: contienen la cola de
# telemetria y la credencial protegida)
/nortis-agent-data/
*.db
*.db-wal
*.db-shm
*.log

# Cobertura y perfiles
*.out
*.test

# Extensiones de WiX que descarga `wix extension add`. Se resuelven desde
# NuGet.config con la version fijada, asi que versionarlas solo añadiria varios
# megabytes de binarios que nadie revisa.
/.wix/

# Certificados de firma. Nunca, bajo ningun concepto, en el repositorio: quien
# tenga la clave privada puede firmar cualquier cosa como BC FABRIC SAS.
*.pfx
*.p12
*.snk
